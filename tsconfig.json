{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2023", "DOM", "DOM.Iterable", "WebWorker"],
    "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "strict": true, "noUnusedLocals": false, "noUnusedParameters": false,
    "skipLibCheck": true, "isolatedModules": true, "noEmit": true,
    "resolveJsonModule": true, "types": ["vite/client"]
  },
  "include": ["src", "tests", "vite.config.ts"]
}
